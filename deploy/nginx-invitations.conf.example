# Example only: merge with your existing reverse proxy configuration.
# Backend: bench port 8002, Frappe site myinvite2u.
# Install a certificate covering *.myinvite2u.in before enabling this block.
# Keep the main domain / Desk in its existing proxy configuration.

server {
    listen 80;
    server_name *.myinvite2u.in;
    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name *.myinvite2u.in;

    # Replace these paths with your actual wildcard certificate files.
    ssl_certificate /etc/letsencrypt/live/myinvite2u.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/myinvite2u.in/privkey.pem;

    location /assets/ {
        alias /home/erpdev/frappe/frappe-bench-v16/sites/assets/;
    }

    location /files/ {
        root /home/erpdev/frappe/frappe-bench-v16/sites/myinvite2u;
        try_files $uri =404;
    }

    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_set_header Host $host;
        proxy_set_header X-Frappe-Site-Name myinvite2u;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
    }
}
